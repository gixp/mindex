<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Inherited entitlements for CHILD processes Mindex spawns (node-pty's
         shell, the `claude` CLI, whisper-cli). The `inherit` key makes a child
         adopt the parent's sandbox/entitlement context; the cs.* allowances let
         V8 / native code run under the hardened runtime. Getting this wrong is
         the #1 cause of "works in dev, dies after notarization" (the plan's
         Risk #2). -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>
