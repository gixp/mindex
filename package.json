{
  "name": "mindex",
  "productName": "Mindex",
  "version": "1.0.2",
  "private": true,
  "description": "Mindex — AI-first personal copilot for notes, calls, projects, and routines",
  "license": "AGPL-3.0-or-later",
  "main": "out/main/index.cjs",
  "type": "module",
  "scripts": {
    "predev": "node scripts/patch-electron-bundle.mjs",
    "dev": "ELECTRON_RUN_AS_NODE= electron-vite dev",
    "build": "electron-vite build",
    "build:icons": "node scripts/build-icons.mjs",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "release:mac": "npm run build && electron-builder --mac --publish never",
    "release:win": "npm run build && electron-builder --win --publish never",
    "release:linux": "npm run build && electron-builder --linux --publish never",
    "rebuild:deps": "electron-builder install-app-deps",
    "patch:bundle": "node scripts/patch-electron-bundle.mjs",
    "preview": "ELECTRON_RUN_AS_NODE= electron-vite preview",
    "prestart": "node scripts/patch-electron-bundle.mjs",
    "start": "ELECTRON_RUN_AS_NODE= electron .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext ts,tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.42.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/electron": "^7.16.0",
    "@tiptap/core": "^3.30.0",
    "@tiptap/extension-drag-handle": "^3.30.0",
    "@tiptap/extension-drag-handle-react": "^3.30.0",
    "@tiptap/extension-image": "3.30.0",
    "@tiptap/extension-link": "^3.30.0",
    "@tiptap/extension-placeholder": "^3.30.0",
    "@tiptap/extension-table": "^3.30.0",
    "@tiptap/extension-task-item": "^3.30.0",
    "@tiptap/extension-task-list": "^3.30.0",
    "@tiptap/markdown": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "@tiptap/suggestion": "^3.30.0",
    "@types/adm-zip": "^0.5.8",
    "@vscode/codicons": "^0.0.45",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.0",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "d3": "^7.9.0",
    "dompurify": "^3.4.14",
    "electron-updater": "^6.8.9",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.46",
    "mermaid": "^11.15.0",
    "minisearch": "^7.1.2",
    "node-pty": "^1.1.0",
    "posthog-node": "^5.48.1",
    "prosemirror-markdown": "^1.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.1",
    "react-resizable-panels": "^2.1.7",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tailwind-merge": "^3.0.1",
    "ulid": "^2.3.0",
    "unified": "^11.0.5",
    "ws": "^8.21.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^43.5.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.0.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.2",
    "prettier": "^3.5.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "node-abi": "^4.35.0",
    "brace-expansion@1": "^1.1.18",
    "lodash-es": "^4.18.1"
  }
}
