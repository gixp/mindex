# Configuration for the Mindex app.
# Copy to `.env` (gitignored) and fill in. Every value is client-safe — a
# publishable key whose data is protected at the far end rather than by being
# secret — and is baked into the build via electron.vite.config.ts.
#
# A blank value makes that integration do nothing, which is fine for a build
# from a clone and is the normal case. It is not silent: Settings →
# Diagnostics → This build lists what is missing, and the release pipeline
# refuses to publish a build with a gap.

# PostHog product analytics (reuse the landing project, EU host).
MINDEX_POSTHOG_KEY=
MINDEX_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry crash/error reporting, and the destination for bug reports people
# write in the app. Create a project at sentry.io and paste the DSN.
MINDEX_SENTRY_DSN=

# Bug reports go to the same Sentry project as crashes — see src/main/feedback
# for why they are not a separate service any more.

# GitHub OAuth App client id, for Publish to GitHub / Clone from GitHub.
# Public by design — the device flow this app uses has no client secret.
# Create at github.com → Settings → Developer settings → OAuth Apps, and tick
# "Enable Device Flow". Blank is fine: sign-in then falls back to the GitHub
# CLI (`gh auth login`), and the dialogs say so instead of offering a dead button.
MINDEX_GITHUB_CLIENT_ID=
